      "id": "n014",
      "name": "Supabase - Fornecedores",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1320,
        -140
      ],
      "credentials": {
        "supabaseApi": {
          "name": "farol_supabase"
        }
      }
