      "parameters": {
        "jsCode": "const config = $('Config').first().json;\nreturn [{ json: { ...config, continuar: true } }];"
      },
      "id": "n005",
      "name": "Continuar sync",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        -40
      ]
    },
    {
      "parameters": {
        "jsCode": "const cfg = $('Continuar sync').first().json;\nconst maxPag = Number(cfg.contatos_max_paginas ?? 30);\nconst pages = [];\nfor (let p = 1; p <= maxPag; p++) {\n  pages.push({ json: { page: p, bling_base_url: cfg.bling_base_url } });\n}\nreturn pages;"
      },
      "id": "n010",
      "name": "Paginas contatos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        -40
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $json.bling_base_url }}/contatos",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "oAuth2Api",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "pagina",
              "value": "={{ $json.page }}"
            },
            {
              "name": "limite",
              "value": "100"
            }
          ]
        },
        "options": {
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": "={{ $('Continuar sync').first().json.bling_interval_ms }}"
            }
          },
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "n011",
      "name": "BLING - Contatos",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        -40
      ],
      "credentials": {
        "oAuth2Api": {
          "name": "bling_vitor"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const cfg = $('Continuar sync').first().json;\nconst COMPANY_ID = cfg.company_id;\nconst map = new Map();\nlet errosApi = 0;\nlet paginasComDados = 0;\nlet contatosVistos = 0;\nlet amostra = null;\n\nfor (const item of $input.all()) {\n  if (item.json.error) { errosApi += 1; continue; }\n  const batch = item.json.data ?? [];\n  if (!Array.isArray(batch) || batch.length === 0) continue;\n  paginasComDados += 1;\n  for (const c of batch) {\n    if (!c?.id) continue;\n    contatosVistos += 1;\n    if (!amostra) {\n      amostra = JSON.stringify({\n        id: c.id,\n        nome: c.nome,\n        tipo: c.tipo,\n        tiposContato: c.tiposContato ?? c.tipoContato ?? null,\n        keys: Object.keys(c).slice(0, 20),\n      }).slice(0, 400);\n    }\n    const externalId = String(c.id);\n    const name = String(c.nome ?? c.razaoSocial ?? c.nomeFantasia ?? ('Contato ' + externalId)).trim();\n    map.set(externalId, {\n      company_id: COMPANY_ID,\n      external_id: externalId,\n      name: name || ('Contato ' + externalId),\n    });\n  }\n}\n\nconst rows = [...map.values()];\nconst chunks = [];\nfor (let i = 0; i < rows.length; i += 50) chunks.push(rows.slice(i, i + 50));\n\nreturn [{\n  json: {\n    chunks,\n    body: chunks[0] ?? [],\n    fornecedores_total: rows.length,\n    contatos_vistos: contatosVistos,\n    paginas_contatos: paginasComDados,\n    erros_contatos: errosApi,\n    amostra_contato: amostra,\n    skip_fornecedores: rows.length === 0,\n    supabase_url: cfg.supabase_url,\n    company_id: COMPANY_ID,\n  },\n}];"
      },
