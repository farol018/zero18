      "id": "n021",
      "name": "BLING - Produtos",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1760,
        -40
      ],
      "credentials": {
        "oAuth2Api": {
          "name": "bling_vitor"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const cfg = $('Continuar sync').first().json;\nconst COMPANY_ID = cfg.company_id;\nconst metaF = $('Montar fornecedores').first().json;\nconst productMap = new Map();\nlet pagesComDados = 0;\nlet errosApi = 0;\n\nfor (const item of $input.all()) {\n  if (item.json.error) { errosApi += 1; continue; }\n  const batch = item.json.data ?? [];\n  if (!Array.isArray(batch) || batch.length === 0) continue;\n  pagesComDados += 1;\n  for (const p of batch) {\n    if (!p?.id) continue;\n    const externalId = String(p.id);\n    const codigo = p.codigo != null ? String(p.codigo).trim() : '';\n    productMap.set(externalId, {\n      company_id: COMPANY_ID,\n      external_id: externalId,\n      sku: codigo || `BLING-${externalId}`,\n      name: p.nome ?? `Produto ${externalId}`,\n      cost_price: p.precoCusto ?? null,\n            unit: p.unidade ?? null,\n    });\n  }\n}\n\nconst products = [...productMap.values()];\nconst chunks = [];\nfor (let i = 0; i < products.length; i += 50) {\n  chunks.push(products.slice(i, i + 50));\n}\n\nreturn [{\n  json: {\n    chunks,\n    count: products.length,\n    pages_com_dados: pagesComDados,\n    erros_api: errosApi,\n    fornecedores_total: metaF.fornecedores_total ?? 0,\n    contatos_vistos: metaF.contatos_vistos ?? 0,\n    erros_contatos: metaF.erros_contatos ?? 0,\n    supabase_url: cfg.supabase_url,\n    skip_post: products.length === 0,\n  },\n}];"
      },
