        "jsCode": "const m = $('Montar produtos').first().json;\nconst f = $('Montar fornecedores').first().json;\nreturn [{\n  json: {\n    status: 'ok',\n    fornecedores: f.fornecedores_total ?? 0,\n    contatos_vistos: f.contatos_vistos ?? 0,\n    produtos: m.count ?? 0,\n    paginas_com_dados: m.pages_com_dados ?? 0,\n    erros_api: m.erros_api ?? 0,\n    erros_contatos: f.erros_contatos ?? 0,\n    amostra_contato: f.amostra_contato ?? null,\n    proximo_passo: 'Importar e rodar FAROL — Vincular Fornecedores',\n  },\n}];"
      },
