    {
      "parameters": {
        "jsCode": "const cfg = $('Continuar sync').first().json;\nconst meta = $('Montar fornecedores').first().json;\nconst pageStart = Number(cfg.page_start ?? 1);\nconst pageEnd = Number(cfg.page_end ?? 50);\nconst tipos = String(cfg.bling_tipos ?? 'T').split(',').map((t) => t.trim()).filter(Boolean);\nconst pages = [];\nfor (const tipo of tipos) {\n  for (let p = pageStart; p <= pageEnd; p++) {\n    pages.push({ json: { page: p, tipo, bling_base_url: cfg.bling_base_url, bling_criterio: cfg.bling_criterio ?? '5', fornecedores_total: meta.fornecedores_total ?? 0 } });\n  }\n}\nreturn pages;"
      },
