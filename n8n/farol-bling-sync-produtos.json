      "parameters": {
        "jsCode": "const row = $input.first().json;\nif (row.skip_post || !row.chunks?.length) {\n  return [{ json: { ...row, body: [], skip_post: true } }];\n}\nreturn row.chunks.map((body) => ({\n  json: {\n    body,\n    skip_post: false,\n    supabase_url: row.supabase_url,\n    count: row.count,\n  },\n}));"
      },
